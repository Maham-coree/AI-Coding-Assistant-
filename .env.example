APP_ENV=development
SECRET_KEY=replace_with_a_long_random_secret
DATABASE_URL=sqlite:///assistant.db
GEMINI_API_KEY=your_api_key_here
# Optional shared rate-limit backend. Use the Redis URL supplied by your provider.
# Empty keeps rate limits in process-local memory (suitable only for local development).
REDIS_URL=
# Optional password reset delivery via authenticated SMTP (STARTTLS on 587 by default;
# implicit TLS is used on port 465).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_DEFAULT_SENDER=
PUBLIC_BASE_URL=http://127.0.0.1:5000
